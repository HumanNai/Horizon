# Horizon PM Environment Configuration
# Copy this file to .env and adjust as necessary for your deployment.

# Server Port (default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Persistent storage directory for SQLite database
DATA_DIR=/app/data
DATABASE_PATH=/app/data/horizon.db

# CORS Allowed Origin (e.g., https://horizon.yourdomain.com)
# Leave empty in development to allow localhost access
ALLOWED_ORIGIN=

# Maximum request payload size for document and Excel imports
MAX_REQUEST_SIZE=50mb

# Cloudflare Tunnel / Reverse Proxy settings
# TRUST_PROXY=true
